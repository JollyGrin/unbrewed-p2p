{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbrewed.xyz/schemas/telemetry/sandbox-events.v1.schema.json",
  "title": "Unbrewed Telemetry Sandbox Events v1",
  "description": "Copy of unbrewed-telemetry's schemas/sandbox-events.v1.schema.json (Emyrk/unbrewed-telemetry#84), built from the shared wire contract. A batch of sandbox (non-Pro) room lifecycle events emitted by the Go relay. Players arrive only as playerHash; raw names are refused.",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "event": {
      "type": "object",
      "required": ["eventId", "type", "roomId", "ts"],
      "additionalProperties": false,
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "type": { "enum": ["room_opened", "player_joined", "player_left", "hero_seen", "room_closed"] },
        "roomId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "playerHash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "connections": { "$ref": "#/$defs/count" },
        "heroName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "enum": ["inactive", "shutdown"] },
        "lifetimeMs": { "$ref": "#/$defs/count" },
        "distinctPlayers": { "$ref": "#/$defs/count" },
        "peakConnections": { "$ref": "#/$defs/count" },
        "stateUpdates": { "$ref": "#/$defs/count" },
        "ts": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["player_joined", "player_left"] } } },
          "then": { "required": ["playerHash", "connections"] }
        },
        {
          "if": { "properties": { "type": { "const": "hero_seen" } } },
          "then": { "required": ["playerHash", "heroName"] }
        },
        {
          "if": { "properties": { "type": { "const": "room_closed" } } },
          "then": { "required": ["reason", "lifetimeMs", "distinctPlayers", "peakConnections", "stateUpdates"] }
        }
      ]
    }
  }
}
